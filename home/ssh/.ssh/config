# ~/.ssh/config: deployed in copy mode with 0600 permissions.
# Per-machine hosts (tailnet boxes, work) go in ~/.ssh/config.local, which is never tracked.
Include ~/.ssh/config.local

IgnoreUnknown UseKeychain

Host github.com
	HostName github.com
	User git
	IdentityFile ~/.ssh/id_ed25519
	IdentitiesOnly yes

Host *
	AddKeysToAgent yes
	UseKeychain yes
	ServerAliveInterval 60
