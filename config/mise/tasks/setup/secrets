#!/usr/bin/env bash
#MISE description="Clone the private secrets overlay and install this machine's age identity"
#MISE depends=["setup:github"]
set -euo pipefail
priv=~/.local/share/dotfiles-private
key=~/.config/mise/age.txt
[ -d "$priv/.git" ] || gh repo clone alliecatowo/dotfiles-private "$priv"
if [ ! -s "$key" ]; then
  # The identity is stored as a Bitwarden note named "age identity (dotfiles)".
  printf 'Paste the AGE-SECRET-KEY-... line (input hidden): '
  read -rs line; echo
  case "$line" in AGE-SECRET-KEY-1*) ;; *) echo "That isn't an age identity."; exit 1 ;; esac
  (umask 077; printf '%s\n' "$line" > "$key")
fi
chmod 600 "$key"
