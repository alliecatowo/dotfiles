#!/usr/bin/env bash
#MISE description="Edit a file in the private overlay; sops re-encrypts it on save"
#USAGE arg "[file]" default="shell.enc.json"
set -euo pipefail
priv=~/.local/share/dotfiles-private
# shellcheck disable=SC2154  # usage_file is set by mise from the #USAGE arg
SOPS_AGE_KEY_FILE=~/.config/mise/age.txt sops edit "$priv/${usage_file}"
git -C "$priv" status --short
echo "Commit and push from $priv when done."
